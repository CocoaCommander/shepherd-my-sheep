# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value below is required — the server exits at startup if any is
# missing, and there are deliberately no defaults for credentials.

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Server ───────────────────────────────────────────────────
# IPv4 or IPv6. 0.0.0.0 listens on all IPv4 interfaces; :: on all IPv6
# and IPv4 (Linux).
API_HOST=
API_PORT=

# Allowed origin for browser requests, e.g. http://localhost:3000
CORS_ORIGIN=

# ── Auth ─────────────────────────────────────────────────────
# HS256 signing key. Minimum 32 bytes — the server refuses to start below
# that. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# "iss" claim, and the value tokens are verified against, e.g. shepherd-my-sheep
JWT_ISSUER=

# Access token lifetime in seconds, e.g. 3600
JWT_ACCESS_TTL=

# ── Rate limiting ────────────────────────────────────────────
# Login and register attempts per client address per minute (also the
# burst), a positive integer. About 10 in production. Set it high, e.g.
# 1000, for local dev so the API test suite can register its users.
AUTH_RATE_LIMIT_PER_MINUTE=

# ── Logging ──────────────────────────────────────────────────
# DEBUG, INFO, WARN or ERROR. DEBUG for local dev (logs every incoming
# request); INFO otherwise.
LOG_LEVEL=

# ── Dev seed (optional) ──────────────────────────────────────
# Only needed for `python -m db.seed`. Every demo user logs in with this.
SEED_USER_PASSWORD=

# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value below is required — the server exits at startup if any is
# missing, and there are deliberately no defaults for credentials.

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Server ───────────────────────────────────────────────────
API_HOST=
API_PORT=

# Allowed origin for browser requests, e.g. http://localhost:3000
CORS_ORIGIN=

# ── Auth ─────────────────────────────────────────────────────
# HS256 signing key. Minimum 32 bytes — the server refuses to start below
# that. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# "iss" claim, and the value tokens are verified against, e.g. shepherd-my-sheep
JWT_ISSUER=

# Access token lifetime in seconds, e.g. 3600
JWT_ACCESS_TTL=
